# Supabase (Project Settings → API). La anon/publishable key es pública por diseño.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# PIN del admin (SOLO DEMO: queda visible en el bundle)
VITE_ADMIN_PIN=1234
# URL pública del deploy, se usa para el QR de /qr
VITE_PUBLIC_URL=https://ravello-jardin.vercel.app

# Solo para el CLI de Supabase (nunca se exponen al front, no llevan VITE_)
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=
